<Window x:Class="CursedApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:CursedApp.Converters"
        xmlns:vm="clr-namespace:CursedApp.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="CursedApp — WoW Addon Manager"
        Icon="/Assets/app.ico"
        Height="720" Width="1180"
        MinHeight="520" MinWidth="900"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        Loaded="OnLoaded"
        PreviewKeyDown="OnPreviewKeyDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
        <conv:NotEmptyToVisibilityConverter x:Key="NotEmptyToVis" />
        <conv:PositiveToVisibilityConverter x:Key="PositiveToVis" />
        <conv:IsNullConverter x:Key="IsNull" />
        <conv:EnumToIndexConverter x:Key="EnumToIndex" />
        <conv:FractionToPercentConverter x:Key="FractionToPercent" />
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    </Window.InputBindings>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- Search box sits above the tabs, per the requirement. -->
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: WoW folder + client -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="World of Warcraft folder" Style="{StaticResource MutedText}" />
                    <TextBlock Text="{Binding WowRootPath, TargetNullValue='Not selected yet'}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding SelectedInstallation.AddonsPath}"
                               Margin="0,2,12,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0"
                            Visibility="{Binding HasWowFolder, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Client" Style="{StaticResource MutedText}" />
                    <!--
                        Width is pinned: this column is Auto, so letting the box
                        size to its content would let a long value squeeze the
                        folder path out of the header entirely.
                    -->
                    <ComboBox ItemsSource="{Binding Installations}"
                              SelectedItem="{Binding SelectedInstallation}"
                              Width="150"
                              Margin="0,2,0,0">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <Button Grid.Column="2"
                        Content="Change folder…"
                        Command="{Binding BrowseFolderCommand}"
                        VerticalAlignment="Bottom"
                        Margin="0,0,8,0" />

                <Button Grid.Column="3"
                        Content="Refresh"
                        Command="{Binding RefreshCommand}"
                        ToolTip="Rescan Interface\AddOns and re-check for updates (F5)"
                        VerticalAlignment="Bottom" />
            </Grid>
        </Border>

        <!-- Search box above the tabs -->
        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <TextBox x:Name="SearchBox"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="14"
                         Padding="10,8"
                         ToolTip="Type an addon name and press Enter to search CurseForge">
                    <TextBox.InputBindings>
                        <!-- Enter runs the search and switches to the Search tab. -->
                        <KeyBinding Key="Return" Command="{Binding SearchCommand}" />
                    </TextBox.InputBindings>
                </TextBox>

                <!-- Placeholder, shown only while the box is empty. -->
                <TextBlock Text="Search addons on CurseForge — press Enter"
                           FontSize="14"
                           IsHitTestVisible="False"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SearchText}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <Button Grid.Column="1"
                    Content="Search"
                    Style="{StaticResource AccentButton}"
                    Command="{Binding SearchCommand}"
                    Padding="18,8"
                    Margin="8,0,0,0" />
        </Grid>

        <!-- Banners stack, so two at once do not sit on top of each other. -->
        <StackPanel Grid.Row="2">

        <!-- Provider hint banner -->
        <Border Margin="0,12,0,0"
                Padding="12,9"
                CornerRadius="6"
                Background="#26E2B341"
                BorderBrush="{StaticResource WarningBrush}"
                BorderThickness="1"
                Visibility="{Binding HasProviderHint, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding ProviderHint}"
                           Foreground="{StaticResource WarningBrush}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Content="Open Settings"
                        Command="{Binding GoToSettingsCommand}"
                        Margin="12,0,0,0" />
            </Grid>
        </Border>

        <!-- A downloaded addon zip turned up in the watched folder -->
        <Border Margin="0,12,0,0"
                Padding="12,9"
                CornerRadius="6"
                Background="#26F16436"
                BorderBrush="{StaticResource AccentBrush}"
                BorderThickness="1"
                Visibility="{Binding HasPendingArchive, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding PendingArchiveText}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Content="Install"
                        Style="{StaticResource AccentButton}"
                        Command="{Binding InstallPendingArchiveCommand}"
                        Margin="12,0,8,0" />
                <Button Grid.Column="2"
                        Content="Ignore"
                        Command="{Binding DismissPendingArchiveCommand}" />
            </Grid>
        </Border>

        </StackPanel>

        <!-- Tabs -->
        <TabControl Grid.Row="3"
                    Margin="0,12,0,0"
                    SelectedIndex="{Binding SelectedTab, Converter={StaticResource EnumToIndex}}">

            <!-- My Addons -->
            <TabItem Header="My Addons">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="{Binding InstalledSummary}"
                                   Style="{StaticResource HeaderText}"
                                   VerticalAlignment="Center" />

                        <Button Grid.Column="1"
                                Content="Install from zip…"
                                Command="{Binding InstallFromZipCommand}"
                                ToolTip="Unpack an addon archive you downloaded yourself"
                                Margin="0,0,8,0" />

                        <Button Grid.Column="2"
                                Style="{StaticResource AccentButton}"
                                Command="{Binding UpdateAllCommand}"
                                Visibility="{Binding UpdateCount, Converter={StaticResource PositiveToVis}}">
                            <TextBlock>
                                <Run Text="Update all" />
                                <Run Text="(" /><Run Text="{Binding UpdateCount, Mode=OneWay}" /><Run Text=")" />
                            </TextBlock>
                        </Button>
                    </Grid>

                    <!--
                        All widths are proportional and horizontal scrolling is off,
                        so the columns always divide the viewport instead of pushing
                        the last one out of sight.
                    -->
                    <DataGrid x:Name="InstalledGrid"
                              Grid.Row="1"
                              ItemsSource="{Binding InstalledAddons}"
                              HorizontalScrollBarVisibility="Disabled">

                        <DataGrid.Columns>

                            <!-- Name, as a link to the addon page when one is known. -->
                            <DataGridTemplateColumn Header="Addon" Width="380">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <!--
                                            Top-anchored with a fixed offset, so the chevron and
                                            the name stay put when the row grows to fit the
                                            nested list instead of drifting towards the edge.
                                        -->
                                        <Grid VerticalAlignment="Top" Margin="0,7,0,7">
                                            <Grid.ColumnDefinitions>
                                                <!--
                                                    Fixed, not Auto: the chevron only exists on
                                                    bundle rows, and an Auto column would shift
                                                    every other addon's name sideways.
                                                -->
                                                <ColumnDefinition Width="26" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!--
                                                Expander, only for a bundle. Pinned to the top so
                                                it stays level with the addon name once the row
                                                grows to fit the nested list.
                                            -->
                                            <!--
                                                The negative left margin pulls the chevron out
                                                over the cell's padding so it sits centred in the
                                                gap between the row edge and the addon name,
                                                without moving the name itself.
                                            -->
                                            <Button Grid.Column="0"
                                                    Style="{StaticResource ExpanderToggle}"
                                                    Command="{Binding ToggleExpandedCommand}"
                                                    VerticalAlignment="Top"
                                                    HorizontalAlignment="Left"
                                                    Margin="-4,0,0,0"
                                                    Visibility="{Binding IsBundle, Converter={StaticResource BoolToVis}}"
                                                    ToolTip="Show the folders this addon installs" />

                                            <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                                <TextBlock Visibility="{Binding HasWebsite, Converter={StaticResource BoolToVis}}"
                                                           TextTrimming="CharacterEllipsis">
                                                    <Hyperlink Command="{Binding OpenWebsiteCommand}"
                                                               ToolTip="{Binding WebsiteUrl}">
                                                        <Run Text="{Binding Name, Mode=OneWay}" />
                                                    </Hyperlink>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Name}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Visibility="{Binding HasWebsite, Converter={StaticResource InverseBoolToVis}}" />
                                                <TextBlock Text="{Binding Author}"
                                                           Style="{StaticResource MutedText}"
                                                           Visibility="{Binding Author, Converter={StaticResource NotEmptyToVis}}" />

                                                <!--
                                                    The folders of a bundle, listed inside the row
                                                    rather than in DataGrid's row-details panel:
                                                    the panel's visibility is coerced by the grid
                                                    and its rows get recycled, which made it
                                                    unreliable. No status and no actions here —
                                                    the addon installs and updates as a unit.
                                                -->
                                                <ItemsControl ItemsSource="{Binding Components}"
                                                              Margin="0,8,0,2"
                                                              Visibility="{Binding ShowsComponents, Converter={StaticResource BoolToVis}}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border BorderBrush="{StaticResource BorderBrush}"
                                                                    BorderThickness="2,0,0,0"
                                                                    Padding="8,2,0,2"
                                                                    Margin="0,1">
                                                                <TextBlock Style="{StaticResource MutedText}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           ToolTip="{Binding DisplayTitle}">
                                                                    <Run Text="{Binding Folder, Mode=OneWay}" />
                                                                </TextBlock>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Folder"
                                                Binding="{Binding FolderSummary}"
                                                Width="150">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                        <Setter Property="ToolTip" Value="{Binding FolderTooltip}" />
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        <Setter Property="VerticalAlignment" Value="Top" />
                                        <Setter Property="Margin" Value="0,7,0,0" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!--
                                The client version the addon targets, read from
                                the toc's "## Interface". An addon's own version
                                string is not comparable between authors, so it
                                lives in the tooltip rather than a column.
                            -->
                            <DataGridTextColumn Header="Game version"
                                                Binding="{Binding GameVersionText}"
                                                Width="130">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        <Setter Property="VerticalAlignment" Value="Top" />
                                        <Setter Property="Margin" Value="0,7,0,0" />
                                        <Setter Property="ToolTip" Value="{Binding VersionTooltip}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Status: an Update button when one is available, plain text otherwise. -->
                            <DataGridTemplateColumn Header="Status" Width="*" MinWidth="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid VerticalAlignment="Top" Margin="0,4,0,0">

                                            <!-- Update available and fetchable -->
                                            <StackPanel Visibility="{Binding CanUpdate, Converter={StaticResource BoolToVis}}">
                                                <Button Style="{StaticResource RowButton}"
                                                        Command="{Binding UpdateCommand}"
                                                        Content="Update"
                                                        ToolTip="{Binding UpdateTooltip}" />
                                            </StackPanel>

                                            <!--
                                                Update available, but the author blocked API downloads.
                                                The version comparison still holds, so say so and offer
                                                the only action that exists.
                                            -->
                                            <StackPanel Visibility="{Binding CanUpdateOnSite, Converter={StaticResource BoolToVis}}">
                                                <!-- Plain button style, so it reads as secondary next to a real Update. -->
                                                <Button Command="{Binding OpenWebsiteCommand}"
                                                        Content="Update on site"
                                                        BorderBrush="{StaticResource WarningBrush}"
                                                        Foreground="{StaticResource WarningBrush}"
                                                        Padding="10,3"
                                                        FontSize="12"
                                                        HorizontalAlignment="Left"
                                                        ToolTip="{Binding OnSiteTooltip}" />
                                            </StackPanel>

                                            <!-- Everything else: text, plus a progress bar while working -->
                                            <StackPanel Visibility="{Binding ShowsStatusText, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding StatusText}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding StatusDetail}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="UpToDate">
                                                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Installing">
                                                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <ProgressBar Margin="0,4,8,0"
                                                             Maximum="100"
                                                             Value="{Binding Progress, Converter={StaticResource FractionToPercent}, Mode=OneWay}"
                                                             IsIndeterminate="{Binding Progress, Converter={StaticResource IsNull}, Mode=OneWay}"
                                                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Search -->
            <TabItem Header="Search">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="{Binding SearchSummary}"
                               Style="{StaticResource HeaderText}"
                               Margin="0,0,0,10" />

                    <DataGrid x:Name="SearchGrid"
                              Grid.Row="1"
                              ItemsSource="{Binding SearchResults}"
                              MinRowHeight="56"
                              HorizontalScrollBarVisibility="Disabled">
                        <DataGrid.Columns>

                            <DataGridTemplateColumn Header="Addon" Width="3.4*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Visibility="{Binding HasWebsite, Converter={StaticResource BoolToVis}}"
                                                       TextTrimming="CharacterEllipsis">
                                                <Hyperlink Command="{Binding OpenWebsiteCommand}"
                                                           ToolTip="{Binding WebsiteUrl}">
                                                    <Run Text="{Binding Name, Mode=OneWay}" />
                                                </Hyperlink>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Name}"
                                                       Visibility="{Binding HasWebsite, Converter={StaticResource InverseBoolToVis}}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Summary}"
                                                       Style="{StaticResource MutedText}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Summary}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Author" Binding="{Binding Author}" Width="1.2*" />

                            <DataGridTextColumn Header="Downloads" Binding="{Binding DownloadsText}" Width="0.85*" />

                            <DataGridTextColumn Header="Updated" Binding="{Binding LastUpdatedText}" Width="0.85*" />

                            <DataGridTemplateColumn Header="Latest version" Width="1.6*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Version, TargetNullValue='—'}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Version}"
                                                   VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="" Width="1.2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center">
                                            <Button Style="{StaticResource RowButton}"
                                                    Command="{Binding InstallCommand}"
                                                    Content="{Binding ActionText}"
                                                    IsEnabled="{Binding CanInstall}" />
                                            <ProgressBar Margin="0,4,8,0"
                                                         Maximum="100"
                                                         Value="{Binding Progress, Converter={StaticResource FractionToPercent}, Mode=OneWay}"
                                                         IsIndeterminate="{Binding Progress, Converter={StaticResource IsNull}, Mode=OneWay}"
                                                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Settings -->
            <TabItem Header="Settings">
                <ScrollViewer Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="720" HorizontalAlignment="Left">

                        <Border Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16"
                                Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Game folder" Style="{StaticResource HeaderText}" />
                                <TextBlock Style="{StaticResource MutedText}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,10"
                                           Text="Pick the folder that contains _retail_, _classic_era_ and friends. It is remembered between runs." />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Text="{Binding WowRootPath, TargetNullValue=''}"
                                             IsReadOnly="True" />
                                    <Button Grid.Column="1"
                                            Content="Browse…"
                                            Command="{Binding BrowseFolderCommand}"
                                            Margin="8,0,0,0" />
                                </Grid>

                                <TextBlock Style="{StaticResource MutedText}"
                                           Margin="0,8,0,0"
                                           Text="{Binding SelectedInstallation.AddonsPath, StringFormat='Addons: {0}', TargetNullValue='No client folder found here yet.'}" />
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16"
                                Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="CurseForge API key" Style="{StaticResource HeaderText}" />
                                <TextBlock Style="{StaticResource MutedText}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,10"
                                           Text="The CurseForge API has no anonymous access. Create a free key at console.curseforge.com; it is stored locally in settings.json. Without a key the installed list still works, read from each addon's .toc file, but versions cannot be checked and search is unavailable." />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}"
                                             FontFamily="Consolas" />
                                    <Button Grid.Column="1"
                                            Content="Save &amp; verify"
                                            Style="{StaticResource AccentButton}"
                                            Command="{Binding SaveApiKeyCommand}"
                                            Margin="8,0,0,0" />
                                    <Button Grid.Column="2"
                                            Content="Get a key"
                                            Command="{Binding OpenApiKeyPageCommand}"
                                            Margin="8,0,0,0" />
                                </Grid>

                                <TextBlock Text="{Binding ApiKeyStatus}"
                                           Style="{StaticResource MutedText}"
                                           Margin="0,8,0,0"
                                           Visibility="{Binding ApiKeyStatus, Converter={StaticResource NotEmptyToVis}}" />
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16"
                                Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Manually downloaded addons" Style="{StaticResource HeaderText}" />
                                <TextBlock Style="{StaticResource MutedText}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,10"
                                           Text="Some authors do not allow downloads through the API — for those, the Status column offers &quot;Update on site&quot; instead. Download the zip from the addon's page into the folder below and this app unpacks it into Interface\AddOns. Only archives containing a folder with a .toc file are touched." />

                                <CheckBox Content="Watch this folder for addon archives"
                                          IsChecked="{Binding WatchDownloads}" />

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Text="{Binding DownloadsFolder, UpdateSourceTrigger=LostFocus}"
                                             IsEnabled="{Binding WatchDownloads}" />
                                    <Button Grid.Column="1"
                                            Content="Browse…"
                                            Command="{Binding BrowseDownloadsFolderCommand}"
                                            IsEnabled="{Binding WatchDownloads}"
                                            Margin="8,0,0,0" />
                                    <Button Grid.Column="2"
                                            Content="Install from zip…"
                                            Command="{Binding InstallFromZipCommand}"
                                            Margin="8,0,0,0" />
                                </Grid>

                                <CheckBox Content="Unpack detected archives immediately, without asking"
                                          IsChecked="{Binding AutoInstallDetectedArchives}"
                                          IsEnabled="{Binding WatchDownloads}"
                                          Margin="0,12,0,0" />

                                <CheckBox Content="Delete the archive after a successful install"
                                          IsChecked="{Binding DeleteArchiveAfterInstall}"
                                          Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16">
                            <StackPanel>
                                <TextBlock Text="Updates" Style="{StaticResource HeaderText}" />
                                <CheckBox Content="Back up replaced folders before updating"
                                          IsChecked="{Binding BackupBeforeUpdate}"
                                          Margin="0,10,0,0" />
                                <TextBlock Style="{StaticResource MutedText}"
                                           TextWrapping="Wrap"
                                           Margin="22,4,0,10"
                                           Text="Copies the old addon folders into the app data directory before extracting the new ones." />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Open app data folder"
                                            Command="{Binding OpenDataFolderCommand}" />
                                    <Button Content="Open logs folder"
                                            Command="{Binding OpenLogFolderCommand}"
                                            Margin="8,0,0,0" />
                                </StackPanel>
                                <TextBlock Text="{Binding DataDirectory}"
                                           Style="{StaticResource MutedText}"
                                           Margin="0,8,0,0"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Status bar -->
        <Border Grid.Row="4"
                Margin="0,12,0,0"
                Padding="12,8"
                CornerRadius="6"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding StatusMessage}"
                           Style="{StaticResource MutedText}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
                <ProgressBar Grid.Column="1"
                             Width="120"
                             IsIndeterminate="True"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                             VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
